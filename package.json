{
  "name": "portfolio",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o --host 0.0.0.0",
    "watch:localnetwork": "ng build --watch --configuration development",
    "build": "ng build",
    "build:href": "ng build --base-href ./",
    "build:ghpages": "ng build --base-href /portfolio-angular-roberjacobo/",
    "build:github": "pnpm run build:href && pnpm run delete:docs && pnpm run copy:dist && pnpm run create-cname",
    "build:github2": "pnpm run build:ghpages && pnpm run delete:docs && pnpm run copy:dist && pnpm run create-cname",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "delete:docs": "del-cli docs",
    "copy:dist": "copyfiles -u 3 dist/portfolio/browser/**/* docs",
    "create-cname": "echo www.robjacobo.dev> docs/CNAME",
    "lint": "eslint ./",
    "lint:fix": "eslint ./ --fix"
  },
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/router": "^22.1.1",
    "aos": "^3.0.0-beta.6",
    "rxjs": "~7.8.0",
    "simple-icons": "^16.28.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@eslint/js": "^10.0.1",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.0.8",
    "zone.js": "^0.16.2"
  }
}
